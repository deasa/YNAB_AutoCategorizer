# YNAB
YNAB_ACCESS_TOKEN=your-ynab-personal-access-token
YNAB_BUDGET_ID=last-used

# Turso DB
LIBSQL_DATABASE_URL=libsql://your-db.turso.io
LIBSQL_AUTH_TOKEN=your-turso-auth-token

# AI Provider — Vertex AI (default)
GOOGLE_CLOUD_PROJECT=your-gcp-project
# GOOGLE_CLOUD_LOCATION=us-central1

# AI Provider — OpenAI (alternative, uncomment to use)
# OPENAI_API_KEY=your-openai-key
# OPENAI_BASE_URL=https://api.openai.com

# App Settings
CONFIDENCE_THRESHOLD=0.7
DRY_RUN=false
RUN_INTERVAL=6h
# Max uncategorized transactions to process per run (0 = unlimited)
MAX_TRANSACTIONS=0
