# YNAB (required)
YNAB_ACCESS_TOKEN=your-ynab-personal-access-token
# The active plan's id
YNAB_BUDGET_ID=your-active-plan-id

# SQLite mirror
FINBOT_DB_PATH=/data/finbot.db

# `finbot serve` scheduler
SYNC_INTERVAL=15m
IMPORT_INTERVAL=6h
# The bank-import trigger is a YNAB write (POST). Keep false unless approved.
IMPORT_ENABLED=false

# /healthz listener and log level (debug, info, warn, error). /healthz returns last_error, so it stays private:
# keep this off MCP_LISTEN_ADDR's port.
HTTP_ADDR=127.0.0.1:8081
LOG_LEVEL=info

# Optional dead-man ping (healthchecks.io), GET after each successful sync, <url>/fail after a failed one.
# A secret: never logged. Empty disables it.
HEALTHCHECK_PING_URL=

# Nightly off-site backup: age-encrypted snapshots stored in Turso. Disabled unless all three are set.
# The age public key. The private key stays on the Mac and is passed to `finbot restore --key`.
BACKUP_AGE_RECIPIENT=
# A secret, like the token: never logged.
BACKUP_TURSO_URL=
BACKUP_TURSO_TOKEN=
# Local time of day to run, and how many backups to keep.
BACKUP_AT=03:17
BACKUP_KEEP=14

# Slack status message: one message finbot edits after every sync and backup. A secret: never logged. Empty disables it.
SLACK_BOT_TOKEN=
# Private channel name; the bot must be a member.
SLACK_STATUS_CHANNEL=finbot-finances

# MCP server in `finbot serve`. Disabled unless MCP_PUBLIC_URL, both GOOGLE_OAUTH_* values and MCP_ALLOWED_EMAILS are set.
# Listen on the container interface, not loopback: the go-sdk DNS-rebinding guard refuses a public Host on loopback.
MCP_LISTEN_ADDR=:8080
# Bare origin of the public endpoint, such as https://finance.example.com (http:// only on loopback).
MCP_PUBLIC_URL=
GOOGLE_OAUTH_CLIENT_ID=
# A secret: never logged.
GOOGLE_OAUTH_CLIENT_SECRET=
# Comma-separated Google accounts allowed to sign in. Never logged.
MCP_ALLOWED_EMAILS=
