# YNAB (required)
YNAB_ACCESS_TOKEN=your-ynab-personal-access-token
# The active plan's id
YNAB_BUDGET_ID=your-active-plan-id

# SQLite mirror
FINBOT_DB_PATH=/data/finbot.db

# `finbot serve` scheduler
SYNC_INTERVAL=15m
IMPORT_INTERVAL=6h
# The bank-import trigger is a YNAB write (POST). Keep false unless approved.
IMPORT_ENABLED=false

# /healthz listener and log level (debug, info, warn, error)
HTTP_ADDR=:8080
LOG_LEVEL=info

# Optional dead-man ping (healthchecks.io), GET after each successful sync, <url>/fail after a failed one.
# A secret: never logged. Empty disables it.
HEALTHCHECK_PING_URL=
